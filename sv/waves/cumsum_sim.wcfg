<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="cumsum_sim.wdb" id="1">
         <top_modules>
            <top_module name="cumsum_tb" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="20.000 ns"></ZoomStartTime>
      <ZoomEndTime time="100.101 ns"></ZoomEndTime>
      <Cursor1Time time="129.997 ns"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="340"></NameColumnWidth>
      <ValueColumnWidth column_width="135"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="4" />
   <wvobject fp_name="/cumsum_tb/clk" type="logic">
      <obj_property name="ElementShortName">clk</obj_property>
      <obj_property name="ObjectShortName">clk</obj_property>
   </wvobject>
   <wvobject fp_name="/cumsum_tb/rst" type="logic">
      <obj_property name="ElementShortName">rst</obj_property>
      <obj_property name="ObjectShortName">rst</obj_property>
   </wvobject>
   <wvobject fp_name="/cumsum_tb/diff_in" type="array">
      <obj_property name="ElementShortName">diff_in[17:0]</obj_property>
      <obj_property name="ObjectShortName">diff_in[17:0]</obj_property>
   </wvobject>
   <wvobject fp_name="/cumsum_tb/total" type="array">
      <obj_property name="ElementShortName">total[17:0]</obj_property>
      <obj_property name="ObjectShortName">total[17:0]</obj_property>
   </wvobject>
</wave_config>

module comparator
    import types::*;
(
    input logic clk,
    input logic n_rst,
    input logic clear,
    input logic count_enable,
    input logic [$clog2(HOP_LEN)-1:0] hoplength,
    input logic [DW-1:0] bram0_data_in,
    input logic [DW-1:0] bram1_data_in,
    input logic [DW-1:0] bram2_data_in,
    input logic [DW-1:0] bram3_data_in,
    output logic [DW-1:0] block_data,
    output logic [$clog2(HOP_LEN)-1:0] count_out,
    output logic hoplength_flag,
    output logic countersel_flag
);
    logic [$clog2(HOP_LEN)-1:0] next_count;
    logic next_hoplength_flag;
    logic [1:0] next_counter_sel;
    logic next_countersel_flag;
    logic [DW-1:0] next_data_block;
    logic [1:0] three;
    logic [1:0] countersel;

assign three = 2'd3;

// flip flops
always_ff @(posedge clk, negedge n_rst) begin 
    if(!n_rst) begin
        count_out <= '0;
        hoplength_flag <= '0;
        countersel <= '0;
        countersel_flag <= '0;
        block_data <= '0;
    end else begin
        count_out <= next_count;
        hoplength_flag <= next_hoplength_flag;
        countersel <= next_counter_sel;
        countersel_flag <= next_countersel_flag;
        block_data <= next_data_block;
    end      
end

// MUX of Bram Data
always_comb begin    
    case (countersel)
        2'd0: next_data_block = bram3_data_in;
        2'd1: next_data_block = bram2_data_in;
        2'd2: next_data_block = bram1_data_in;
        2'd3: next_data_block = bram0_data_in;
        default: next_data_block = '0;
    endcase 
end

// hoplength counter block
always_comb begin
    next_count = count_out;
    next_hoplength_flag = '0;
    if (clear) begin
        next_count = 0;
        next_hoplength_flag = 0;
    end else if (count_enable) begin
        if(count_out == hoplength) begin
            next_count = 1;
            next_hoplength_flag = 1;
        end else if (count_out > hoplength) begin
            next_count = 1;
            next_hoplength_flag = 0;
        end else begin
            next_count = count_out + 1;
            next_hoplength_flag = 0;
        end
    end
end

// bram counter block
always_comb begin 
    next_counter_sel = countersel;
    next_countersel_flag = '0;
    if (clear) begin
        next_counter_sel = 0;
        next_countersel_flag = 0;
    end else if (hoplength_flag) begin
        if(countersel == three) begin
            next_counter_sel = 0;
            next_countersel_flag = 1;
        end else if (countersel > three) begin
            next_counter_sel = 0;
            next_countersel_flag = 0;
        end else begin
            next_counter_sel = countersel + 1;
            next_countersel_flag = 0;
        end
    end
end

endmodule
